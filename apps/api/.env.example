# ------------------------------------------------------------------
# MoneyPilot API — environment configuration
# Copy to .env and fill in real values. Never commit .env files.
# ------------------------------------------------------------------

# Local development uses the generated SQLite twin (prisma/schema.sqlite.prisma).
# After `npm install`, run `npm run db:dev` (in apps/api) to create prisma/dev.db.
# Production (Render + Neon) points DATABASE_URL at PostgreSQL, e.g.:
#   DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"
#
# Production also needs DIRECT_DATABASE_URL: the Neon DIRECT (non-pooled)
# connection string, used only by `prisma migrate deploy`. The runtime keeps
# using the pooled DATABASE_URL; the direct endpoint gives migrations the
# real sessions/advisory locks that Neon's pooled endpoint can't provide.
# Get it from Neon -> Connection Details -> "Direct connection".
#   DIRECT_DATABASE_URL="postgresql://user:password@ep-xxx.aws.neon.tech/dbname?sslmode=require"
DATABASE_URL="file:./dev.db"

# Public https:// URL of the WEB app (e.g. your Vercel deployment). Used to
# build email links (verification / password reset) and as the default allowed
# origin for CSRF checks. In production it must be https:// so the __Host-
# auth cookies are accepted by browsers.
APP_BASE_URL="http://localhost:3000"

# Extra origins explicitly allowed for cross-origin API requests (comma or
# newline separated, exact origins, e.g. Vercel preview deployments or a
# custom domain in addition to APP_BASE_URL). Leave empty for none.
# ALLOWED_ORIGINS="https://moneypilot.vercel.app"

# Invite-only mode: when "true", new registrations require an invitation token
# created by an administrator. Existing users can still log in.
PRIVATE_MODE="false"

# Optional bootstrap administrator, created idempotently by running:
#   node apps/api/scripts/bootstrap-admin.mjs
# Recommended for private deployments so the first admin can invite others.
# The script never overrides an existing account with the same email.
# SEED_ADMIN_EMAIL="admin@example.com"
# SEED_ADMIN_PASSWORD="changeme"

# Secret used to sign access tokens (HMAC-SHA256). Minimum 32 characters.
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_JWT_SECRET=""

# Refresh-token lifetime in days (web sessions are capped to this too).
AUTH_REFRESH_TTL_DAYS="30"

# Email delivery. Development uses a console logger so no SMTP is required.
# SMTP_HOST=""
# SMTP_PORT="587"
# SMTP_USER=""
# SMTP_PASS=""
# SMTP_FROM="MoneyPilot <no-reply@example.com>"
# SMTP_SECURE="false"

# Rate limits: requests per window (seconds) for the in-memory limiter used
# on authentication endpoints. In-memory limiting is per-instance.
RATE_LIMIT_AUTH_MAX="20"
RATE_LIMIT_AUTH_WINDOW_SECONDS="60"

# "Continue with Google" (optional). Create an OAuth 2.0 Web application in
# the Google Cloud Console (Credentials page) and add
#   <APP_BASE_URL>/api/auth/google/callback
# as an Authorized redirect URI. When unset, the Google sign-in endpoints
# redirect back with a clear "not configured" error.
# GOOGLE_CLIENT_ID=""
# GOOGLE_CLIENT_SECRET=""

# Port the API listens on. Render injects PORT; local default is 4000.
# PORT="4000"
