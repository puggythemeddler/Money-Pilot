{
  "name": "@moneypilot/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "author": "puggythemeddler",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc --noEmit && esbuild src/server.ts --bundle --platform=node --format=esm --target=node20 --external:@prisma/client --external:hono --external:@hono/node-server --external:jose --external:bcryptjs --external:zod --outfile=dist/server.js --sourcemap",
    "start": "node dist/server.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "db:dev": "prisma generate --schema prisma/schema.sqlite.prisma && prisma db push --schema prisma/schema.sqlite.prisma",
    "db:schema:sqlite": "node scripts/make-sqlite-schema.mjs",
    "postinstall": "prisma generate --schema prisma/schema.sqlite.prisma"
  },
  "dependencies": {
    "@hono/node-server": "^1.17.0",
    "@moneypilot/shared": "*",
    "@prisma/client": "^6.5.0",
    "bcryptjs": "^2.4.3",
    "hono": "^4.9.0",
    "jose": "^5.9.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.10.0",
    "esbuild": "^0.25.0",
    "eslint": "^9.17.0",
    "globals": "^16.0.0",
    "prisma": "^6.5.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.18.0",
    "vitest": "^3.0.0"
  }
}
