# ------------------------------------------------------------------
# MoneyPilot Web — environment configuration
# Copy to .env and fill in real values. Never commit .env files.
#
# The web app is frontend-only: all data comes from the MoneyPilot API
# (apps/api), which owns DATABASE_URL, secrets and SMTP settings.
# ------------------------------------------------------------------

# Origin of the MoneyPilot API service that /api/* requests are proxied to.
# Local development (npm run dev in apps/api) defaults to this value.
# Production (Render + Vercel): set this to your API service's https origin,
# e.g. "https://moneypilot-api.onrender.com".
MONEYPILOT_API_ORIGIN="http://localhost:4000"
