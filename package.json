{
  "name": "moneypilot",
  "version": "0.1.0",
  "private": true,
  "description": "MoneyPilot — personal finance, expense, debt and financial planning platform.",
  "license": "UNLICENSED",
  "author": "puggythemeddler",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "dev:web": "turbo run dev --filter=@moneypilot/web",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "check:migrations": "node scripts/check-migrations.mjs",
    "e2e": "npm run e2e --workspace @moneypilot/e2e"
  },
  "engines": {
    "node": ">=24.0.0",
    "npm": ">=10.0.0"
  },
  "overrides": {
    "postcss": "^8.5.28",
    "source-map-js": "^1.2.2",
    "sharp": "^0.35.5",
    "deepmerge-ts": "^8.0.2"
  },
  "devDependencies": {
    "turbo": "^2.3.0",
    "typescript": "^5.6.0"
  },
  "packageManager": "npm@11.11.0"
}
